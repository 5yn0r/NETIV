format_version: 1
metadata:
  title: Le pare-feu trop zélé
  description: |-
    Depuis ce matin, le site web de la DMZ (10.9.0.10, port 80) est inaccessible
    depuis le LAN. Le serveur fonctionne. Que s'est-il passé sur le chemin ?
  author: NETIV
topology:
  network:
    name: dmz
    seed: 7
  devices:
  - name: PC1
    type: host
    interfaces:
    - name: eth0
      ip: 192.168.1.10/24
    gateway: 192.168.1.1
    services:
    - proto: tcp
      port: 22
      name: ssh
  - name: PC2
    type: host
    interfaces:
    - name: eth0
      ip: 192.168.1.11/24
    gateway: 192.168.1.1
  - name: SW1
    type: switch
    interfaces:
    - name: p1
      vlan: 10
    - name: p2
      vlan: 10
    - name: p3
      vlan: 10
  - name: FW1
    type: firewall
    interfaces:
    - name: eth0
      ip: 192.168.1.1/24
    - name: eth1
      ip: 10.9.0.1/24
    acl:
      rules:
      - action: allow
        proto: tcp
        dst: 10.9.0.0/24
        port: '80'
        in: eth0
        comment: LAN vers web DMZ
      - action: allow
        proto: icmp
        in: eth0
        comment: ping depuis le LAN
  - name: SRV
    type: server
    interfaces:
    - name: eth0
      ip: 10.9.0.10/24
    gateway: 10.9.0.1
    services:
    - proto: tcp
      port: 80
      name: http
    - proto: tcp
      port: 22
      name: ssh
  links:
  - a: PC1:eth0
    b: SW1:p1
  - a: PC2:eth0
    b: SW1:p2
  - a: SW1:p3
    b: FW1:eth0
  - a: FW1:eth1
    b: SRV:eth0
challenge:
  id: intermediate-05
  title: Le pare-feu trop zélé
  topic: security
  difficulty: medium
  description: |
    Depuis ce matin, le site web de la DMZ (10.9.0.10, port 80) est inaccessible
    depuis le LAN. Le serveur fonctionne. Que s'est-il passé sur le chemin ?
  time_limit_minutes: 20
  objective:
    from: PC1
    to: 10.9.0.10
    service:
      proto: tcp
      port: 80
  faults:
  - acl_insert:
      device: FW1
      rule:
        action: deny
        proto: tcp
        port: '80'
        in: eth0
        comment: ajouté par erreur
  solution:
    cause: filtered
    device: FW1
    explanation: |
      Une règle « deny tcp port 80 » a été insérée en tête de liste sur FW1 : elle
      passe avant la règle qui autorisait le web. La première règle qui correspond
      gagne ; il faut supprimer la règle fautive.
    commands:
    - acl del FW1 1
